<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rejoindre - Specus Lucrosus</title>

  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #000;
      color: #fff;
      font-family: Arial, sans-serif;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background-color: #8b0000;
      padding: 20px 30px;
    }

    .header h1 {
      margin: 0;
      font-size: 1.8rem;
      letter-spacing: 2px;
    }

    .header a {
      color: #fff;
      text-decoration: underline;
    }

    .join-section {
      text-align: center;
      padding: 100px 30px;
    }

    .join-button {
      background-color: #8b0000;
      color: #fff;
      border: 2px solid #ff9999;
      padding: 20px 40px;
      font-size: 1.2rem;
      letter-spacing: 1px;
      text-transform: uppercase;
      cursor: pointer;
      border-radius: 6px;
    }

    .join-button:hover {
      background-color: #a30000;
    }

    .join-button:disabled {
      background-color: #333;
      border-color: #555;
      color: #999;
      cursor: not-allowed;
    }

    .leave-button {
      background-color: #200000;
      color: #ff9999;
      border: 2px solid #660000;
      padding: 12px 24px;
      font-size: 1rem;
      letter-spacing: 1px;
      text-transform: uppercase;
      cursor: pointer;
      border-radius: 6px;
      margin-top: 40px;
      display: none;
    }

    .leave-button:hover {
      background-color: #330000;
    }

    .leave-note {
      display: none;
      max-width: 500px;
      margin: 15px auto 0;
      font-size: 0.75rem;
      color: #999;
      line-height: 1.4;
    }

    .join-message {
      margin-top: 25px;
      font-size: 1.1rem;
      color: #ffdddd;
    }
  </style>
</head>

<body>

  <header class="header">
    <h1>SPECUS LUCROSUS</h1>
    <a href="index.html">← Retour</a>
  </header>

  <section class="join-section">
    <button id="joinBtn" class="join-button" onclick="devenirMembre()">Devenir membre de Specus Lucrosus</button>
    <p id="joinMessage" class="join-message"></p>

    <br>

    <button id="leaveBtn" class="leave-button" onclick="quitterMembre()">Je quitte Specus Lucrosus</button>
    <p id="leaveNote" class="leave-note">(parce que je suis un traître, que je suis tout simplement méchant, que je trompe tout le monde, que je ne sais pas ce qui est bon pour moi et que si je me cogne le petit orteil, je l'aurai bien mérité !)</p>
  </section>

  <script>
    function devenirMembre() {
      localStorage.setItem('specusMembre', 'true');
      afficherEtatMembre();
    }

    function quitterMembre() {
      localStorage.removeItem('specusMembre');
      afficherEtatMembre();
    }

    function afficherEtatMembre() {
      const joinBtn = document.getElementById('joinBtn');
      const msg = document.getElementById('joinMessage');
      const leaveBtn = document.getElementById('leaveBtn');
      const leaveNote = document.getElementById('leaveNote');

      if (localStorage.getItem('specusMembre') === 'true') {
        joinBtn.disabled = true;
        joinBtn.textContent = 'Tu es déjà membre !';
        msg.textContent = 'Bienvenue dans la confrérie de Specus Lucrosus.';
        leaveBtn.style.display = 'inline-block';
        leaveNote.style.display = 'block';
      } else {
        joinBtn.disabled = false;
        joinBtn.textContent = 'Devenir membre de Specus Lucrosus';
        msg.textContent = '';
        leaveBtn.style.display = 'none';
        leaveNote.style.display = 'none';
      }
    }

    afficherEtatMembre();
  </script>
<a href="rejoindre.html">Rejoindre</a>
</body>
</html>
